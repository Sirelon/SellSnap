/composeApp/src/androidMain/assets/

# Xcode
xcuserdata/
*.xcodeproj/*
!*.xcodeproj/project.pbxproj
!*.xcodeproj/xcshareddata/
!*.xcodeproj/project.xcworkspace/
!*.xcworkspace/contents.xcworkspacedata
**/xcshareddata/WorkspaceSettings.xcsettings
*.ipa
*.dSYM
*.dSYM.zip
# Per-machine Xcode settings (App Check debug token)
*.local.xcconfig
# Signing profiles from `fastlane run sigh`; they live in Xcode's profile folder
*.mobileprovision

# Secrets and signing keys
.env
.env.local
/keystore.properties
*.jks
*.keystore
/fastlane/google-play-key.json
/fastlane/*.p8

# Fastlane output
/fastlane/report.xml
/fastlane/Preview.html
/fastlane/test_output/

# Node, Python, Firebase CLI
node_modules/
__pycache__/
*.pyc
.firebase/
firebase-debug.log
firebase-debug.*.log

# Agent tooling: per-machine settings, scratch notes, worktrees
/.claude/settings.json
/.claude/tmp/
/.claude/worktrees/
/.conductor/

# Owner's private notes
/marketing/

# Store screenshot generator byproducts and review sheets (regenerated on every run)
*.raw.png
/store/assets/**/*.svg
!/store/assets/play-store/feature-graphic/**/*.svg
/store/previews/

# Store banners: banner.html is the source; the images beside it are inputs and renders
/Design/store-banners/*/*
!/Design/store-banners/*/banner.html
