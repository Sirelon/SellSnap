# macOS and editors
.DS_Store
.idea/
*.iml
.vscode/

# Gradle, Kotlin, Android
.gradle/
.kotlin/
build/
!src/**/build/
local.properties
.externalNativeBuild/
.cxx/
*.apk
*.aab
*.hprof
*.class
*.log
*.jar
!/gradle/wrapper/gradle-wrapper.jar
/androidApp/release/
/server/bin/
