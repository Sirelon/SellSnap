require "shellwords"

default_platform(:ios)


APP_IDENTIFIER = "com.sirelon.sellsnap"
IOS_PROJECT    = "iosApp/iosApp.xcodeproj"
IOS_SCHEME     = "iosApp"
ANDROID_AAB         = "androidApp/build/outputs/bundle/release/androidApp-release.aab"
GOOGLE_PLAY_KEY     = "fastlane/google-play-key.json"

ASC_KEY_ID       = "G5TTXS7GV3"
ASC_ISSUER_ID    = "8873b38c-775e-4a3e-baf5-4e2bada765a8"
# Plain Ruby File.* calls in this Fastfile run relative to the fastlane/
# folder itself, not the repo root actions like gradle()/build_app() resolve
# their string params against, so anchor these to __dir__ explicitly.
ASC_KEY_FILEPATH = File.expand_path("AuthKey_G5TTXS7GV3.p8", __dir__)

# The Xcode project also has a Crashlytics dSYM upload Run Script build phase,
# but that fires the SDK's own async "run" script (fire-and-forget, logged only
# to Console.app) - fine for a local Xcode build left open, not reliable in a
# non-interactive fastlane run that exits right after. upload_symbols_to_crashlytics
# below is the synchronous, fastlane-driven backstop; keeping both is intentional,
# duplicate uploads for the same build are a harmless no-op on Firebase's side.
# Firebase ships via SPM here (no Podfile/Pods/), so the upload-symbols binary
# isn't auto-discoverable the way a Pods install would be - it lives under
# DerivedData/SourcePackages, which is why derived_data_path is pinned below
# instead of left at gym's normal randomized-hash default.
IOS_DERIVED_DATA_PATH = "iosApp/build/DerivedData"
CRASHLYTICS_UPLOAD_SYMBOLS_BINARY = "#{IOS_DERIVED_DATA_PATH}/SourcePackages/checkouts/firebase-ios-sdk/Crashlytics/upload-symbols"
GOOGLE_SERVICE_INFO_PLIST = "iosApp/iosApp/GoogleService-Info.plist"

# version.properties (repo root) is the single source of truth for the app
# version, shared by Android (read directly in build.gradle.kts) and iOS
# (synced into the Xcode project below before every build).
VERSION_PROPERTIES = File.expand_path("../version.properties", __dir__)

# -allowProvisioningUpdates lets xcodebuild create the signing assets a build
# needs (distribution certificate, App IDs, profiles, App Group capabilities),
# but only if it can authenticate. app_store_connect_api_key above feeds
# pilot/deliver, not xcodebuild - without these three flags the archive export
# fails with "No Accounts" and a cascade of "No signing certificate" errors.
TEAM_ID = "5MF89WU7WQ"
SHARE_EXTENSION_IDENTIFIER = "#{APP_IDENTIFIER}.ShareExtension"

# The archive signs automatically, but the export must not: xcodebuild insists
# on its own cloud-managed "iOS Team Store Provisioning Profile" there, which
# fails with "Cloud signing permission error" and, since that profile predates
# the share extension, also reports the App Group as unsupported. These two
# profiles are the ones created by `fastlane run sigh` (recreate them the same
# way after a certificate renewal - the names are sigh's own convention).
APP_STORE_PROFILES = {
  APP_IDENTIFIER => "#{APP_IDENTIFIER} AppStore",
  SHARE_EXTENSION_IDENTIFIER => "#{SHARE_EXTENSION_IDENTIFIER} AppStore"
}.freeze

PROVISIONING_XCARGS = [
  "-allowProvisioningUpdates",
  "-authenticationKeyPath", Shellwords.escape(ASC_KEY_FILEPATH),
  "-authenticationKeyID", ASC_KEY_ID,
  "-authenticationKeyIssuerID", ASC_ISSUER_ID
].join(" ")

# Per-locale release notes / promotional text live outside the repo tree
# (.claude/tmp/ is gitignored) - they're regenerated fresh every release by the
# sellsnap-release skill, not meant to be tracked or pushed.
# android/<locale>/changelogs/<version_code>.txt is read automatically by
# upload_to_play_store (supply) via metadata_path, below.
# ios/<locale>/{release_notes,promotional_text}.txt is read automatically by
# upload_to_app_store (deliver) via metadata_path, below, once skip_metadata is
# false. pilot (TestFlight) has no such folder convention, so read the same
# release_notes.txt files by hand and pass them as localized_build_info.
RELEASE_METADATA_DIR = File.expand_path("../.claude/tmp/release-metadata", __dir__)
ANDROID_METADATA_DIR = File.join(RELEASE_METADATA_DIR, "android")
IOS_METADATA_DIR = File.join(RELEASE_METADATA_DIR, "ios")

def testflight_whats_new
  Dir.glob("#{IOS_METADATA_DIR}/*/release_notes.txt").each_with_object({}) do |path, hash|
    locale = File.basename(File.dirname(path)).to_sym
    hash[locale] = { whats_new: File.read(path).strip }
  end
end

def read_version_properties
  File.read(VERSION_PROPERTIES).lines.each_with_object({}) do |line, h|
    key, value = line.strip.split("=", 2)
    h[key] = value if key && value
  end
end

# deliver picks a build only as part of submitting for review, and the ios release lane
# deliberately does not submit - so passing it build_number sets nothing, and the App
# Store version sits there with no binary until someone selects it by hand. Attach it
# explicitly instead. Idempotent: re-attaching the build already selected is a no-op.
def attach_build_to_app_store_version(props)
  version_name = props.fetch("VERSION_NAME")
  version_code = props.fetch("VERSION_CODE")

  Spaceship::ConnectAPI.token = Spaceship::ConnectAPI::Token.create(
    key_id: ASC_KEY_ID,
    issuer_id: ASC_ISSUER_ID,
    filepath: ASC_KEY_FILEPATH
  )
  app = Spaceship::ConnectAPI::App.find(APP_IDENTIFIER)
  version = app.get_edit_app_store_version
  UI.user_error!("No editable App Store version for #{version_name} - it may already be in review.") if version.nil?

  # Filtering server-side on preReleaseVersion.version is rejected by the API, so match
  # the train and build number locally over the most recent uploads instead.
  build = Spaceship::ConnectAPI.get_builds(
    filter: { app: app.id },
    sort: "-uploadedDate",
    limit: 20,
    includes: "preReleaseVersion"
  ).to_models.find do |candidate|
    candidate.version.to_s == version_code && candidate.pre_release_version&.version.to_s == version_name
  end
  UI.user_error!("Build #{version_code} (#{version_name}) is not on App Store Connect yet - run `fastlane ios beta` first.") if build.nil?

  version.select_build(build_id: build.id)
  UI.success("Attached build #{version_code} to App Store version #{version.version_string}.")
end

# ---------------------------------------------------------------------------
# iOS
# ---------------------------------------------------------------------------

platform :ios do
  before_all do
    next unless File.exist?(ASC_KEY_FILEPATH)

    app_store_connect_api_key(
      key_id: ASC_KEY_ID,
      issuer_id: ASC_ISSUER_ID,
      key_filepath: ASC_KEY_FILEPATH
    )
  end

  desc "Sync MARKETING_VERSION / CURRENT_PROJECT_VERSION from version.properties"
  private_lane :sync_version do
    props = read_version_properties

    increment_version_number(
      xcodeproj: IOS_PROJECT,
      version_number: props.fetch("VERSION_NAME")
    )
    increment_build_number(
      xcodeproj: IOS_PROJECT,
      build_number: props.fetch("VERSION_CODE")
    )
  end

  private_lane :upload_dsyms_to_crashlytics do
    upload_symbols_to_crashlytics(
      dsym_path: lane_context[SharedValues::DSYM_OUTPUT_PATH],
      gsp_path: GOOGLE_SERVICE_INFO_PLIST,
      binary_path: CRASHLYTICS_UPLOAD_SYMBOLS_BINARY
    )
  end

  desc "Build and upload a new beta to TestFlight"
  lane :beta do
    sync_version
    Bundler.with_unbundled_env do
      build_app(
        project: IOS_PROJECT,
        scheme: IOS_SCHEME,
        export_method: "app-store",
        derived_data_path: IOS_DERIVED_DATA_PATH,
        xcargs: PROVISIONING_XCARGS,
        export_team_id: TEAM_ID,
        export_options: {
          signingStyle: "manual",
          signingCertificate: "Apple Distribution",
          provisioningProfiles: APP_STORE_PROFILES
        }
      )
    end
    upload_dsyms_to_crashlytics
    # No skip_waiting_for_build_processing here: pilot's "partial wait" (needed
    # before build info can be attached at all) only checks the plain
    # `changelog` option, not `localized_build_info` - confirmed against
    # fastlane's build_manager.rb. With skip_waiting_for_build_processing and
    # no `changelog`, it returns immediately and localized_build_info is
    # silently never applied (discovered exactly this way in testing - the
    # binary uploaded fine, but What's New didn't attach). Waiting for full
    # processing is the only documented way to reliably get it applied.
    upload_to_testflight(
      localized_build_info: testflight_whats_new
    )
  end

  desc "Create/update the App Store version for the build already on TestFlight and publish its metadata (does not rebuild, does not submit for review)"
  lane :release do
    props = read_version_properties
    upload_to_app_store(
      app_identifier: APP_IDENTIFIER,
      app_version: props.fetch("VERSION_NAME"),
      build_number: props.fetch("VERSION_CODE"),
      skip_binary_upload: true,
      skip_screenshots: true,
      skip_metadata: false,
      submit_for_review: false,
      automatic_release: false,
      run_precheck_before_submit: false,
      metadata_path: IOS_METADATA_DIR,
      force: true
    )
    attach_build_to_app_store_version(props)
  end
end

# ---------------------------------------------------------------------------
# Android
# ---------------------------------------------------------------------------

platform :android do
  desc "Build release AAB and upload to Play Store internal testing"
  lane :beta do
    gradle(task: ":androidApp:bundleRelease")
    upload_to_play_store(
      track: "internal",
      aab: ANDROID_AAB,
      json_key: GOOGLE_PLAY_KEY,
      skip_upload_apk: true,
      metadata_path: ANDROID_METADATA_DIR
    )
  end

  desc "Promote the latest internal build to production on Play Store"
  lane :release do
    upload_to_play_store(
      track: "internal",
      track_promote_to: "production",
      json_key: GOOGLE_PLAY_KEY
    )
  end

  desc "Build release AAB without uploading"
  lane :build do
    gradle(task: ":androidApp:bundleRelease")
  end
end
