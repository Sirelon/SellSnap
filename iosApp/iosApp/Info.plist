<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CADisableMinimumFrameDurationOnPhone</key>
	<true/>
	<!-- Analytics and crash reporting are both on by default; the user can opt out from
	     Settings (see AnalyticsConsentRepository). This must stay true so the SDK can emit the
	     once-per-install first_open and the launch session_start, which are generated during
	     FirebaseApp.configure() and cannot be backfilled by a later runtime enable. Opting out
	     calls setAnalyticsCollectionEnabled(false), which Firebase persists across launches and
	     which takes precedence over this default. -->
	<key>FIREBASE_ANALYTICS_COLLECTION_ENABLED</key>
	<true/>
	<key>FirebaseCrashlyticsCollectionEnabled</key>
	<true/>
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.sirelon.sellsnap.olx</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>selolxai</string>
			</array>
		</dict>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>SellSnap needs camera access to capture photos for your OLX listing.</string>
	<key>NSLocationWhenInUseUsageDescription</key>
	<string>SellSnap uses your location to suggest the nearest city for your OLX advertisement.</string>
</dict>
</plist>
