rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /release-notes/{document=**} {
      allow read: if true;
      allow write: if false;
    }

    // Ad-generation diagnostic logging (AdGenerationLogRepository). 3.2+ nests documents under
    // the Firebase installation ID rather than an OLX account, since guest-mode attempts never
    // have one: ad_generations/{installationId}/attempts/{document}. 3.1 and older - still active
    // in the field - write the flat ad_generations/{document} path instead: 85 of 129 generation
    // logs in the 14-23 Sep 2026 window (66%) were still on it. The wildcard below has to match
    // both, or deploying this file would silently reject every 3.1 write. The app has no Firebase
    // Auth (OLX OAuth only), so writes are unauthenticated; document IDs are random UUIDs the
    // client mints itself. Clients never read this collection back, so read stays denied.
    match /ad_generations/{document=**} {
      allow read, delete: if false;
      allow create, update: if true;
    }
  }
}
